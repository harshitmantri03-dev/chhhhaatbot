# BotSpace
BOTSPACE_API_KEY=your_botspace_api_key_here
BOTSPACE_CHANNEL_ID=6a7ee53dd30b3992237344ac

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=/data/service_account.json

# SQLite (must live on a persistent Railway volume, e.g. mounted at /data)
DB_PATH=/data/bot.db

# Optional: shared secret to verify webhook calls actually come from BotSpace
WEBHOOK_SECRET=

# Optional: auto-resume AI after this many hours of no human reply (0 = disabled)
AUTO_RESUME_HOURS=0
